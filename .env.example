# Copy to .env and fill in. Never commit .env.
# Generate strong passwords with:  openssl rand -base64 24

# Database
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=lmaildb
MYSQL_USER=lmail
MYSQL_PASSWORD=change-me

# Production only: the address LMAIL is served on (DNS must point at the server)
LMAIL_DOMAIN=app.laibstudios.com

# Optional
# LMAIL_HTTP_PORT=8080      # local port (default 8080)
# MAUTIC_VERSION=5-apache   # pin e.g. 5.2.1-apache for production
# TZ=UTC
